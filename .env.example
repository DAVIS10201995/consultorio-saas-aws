# Copia este archivo como .env y cambia los valores. El .env NO se sube a git.
# Para generar valores aleatorios:
#   docker run --rm php:8.4-cli php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
POSTGRES_PASSWORD=cambiar
MIGRADOR_PW=cambiar
APP_PW=cambiar

# Llave de Laravel:
#   docker run --rm php:8.4-cli php -r "echo 'base64:', base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=base64:cambiar
